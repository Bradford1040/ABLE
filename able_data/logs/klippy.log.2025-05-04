hardware_pwm = false
fan_speed = 1.0
cycle_time = 0.0166
kick_start_time = 0.5
heater = extruder
heater_temp = 50.0

[controller_fan driver_Fan]
pin = PB5
max_power = 1.0
shutdown_speed = 0
cycle_time = 0.010
hardware_pwm = False
kick_start_time = 0.100
fan_speed = 1.0
idle_timeout = 120
idle_speed = 0.25
heater = extruder
